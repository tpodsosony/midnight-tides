---
import Layout from "../layouts/Layout.astro";
import Card from "../components/card.astro";
const pageTitle = "Interests";
---

<Layout pageTitle={pageTitle}>
    <div class = "opencards" > 
        <details name = "General">
            <summary>𓆩♡𓆪 What is generally going on in my life 𓆩♡𓆪</summary>
            <Card title = "General"> 
                Studying for certifications, waiting for ankle to heal up. Trying my best not to be bored at a desk and only doing upper body workouts for physical activity.
            </Card>
        </details>
    </div> 
    
    
    
    <br/>
    
    <div class = "opencards"> 
        <details name = "General">
            <summary>≪ °❈° ≫ Current media interests ≪ °❈° ≫</summary>
            <Card title = "Media">
                <ul>
                    <li>Playing Shin Megami Tensei IV: Apocalypse, and Fire Emblem: Fortunes Weave</li>
                    <li>Reading The Left Hand of Darkness</li>
                    <li>Watching Widow's Peak and a bunch of recent movie releases</li>
                    <li>Arcs the board game has taken over my board gaming life</li>
                </ul>      
            </Card>
        </details>
    </div>
    
    <br/>
    
    <div class = "opencards" > 
        <details name = "General">
            <summary>✮✮✮ Current projects in the works ✮✮✮</summary>
            <Card title = "Projects">
                <ul>
                    <li>Finished up a fan page on here,, next big idea might be a more organized book page</li>
                    <li>Creating a small music video</li>
                    <li>Learning new types of poetry</li>
                </ul>
        </Card>
        </details>
    </div>
    
    <br/>
    <small>Last updated on October 19th, 2026.</small>
</Layout>

<style>
    small{
        float:right;
    }
    
    .opencards{
        border-style:ridge;
        margin:auto;
        width: 400px;
        padding: 1em;
        border-color: rgba(232, 42, 211, 0.54);
        
    }
    
    .opencards summary{
        text-align:left;
    }
    
    ul{
        padding-left: 1em;
        margin:0;
    }
</style>

---
import '../styles/jackfrost.css';

import SlowText from '../components/slowText.astro';
import JackFrost from '../assets/jackFrost/JFSprite.gif';
import DialogueButton from '../components/dialogueButton.astro';

const dialogueFistbump = ["fistbump", "no"];

---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Hee-Ho!</title>
	</head>
	
<body>
    <div class = "container">
        <img src={JackFrost.src} alt = "this is an image" class = "jfGif"/>
        <br/>
        <div class ="textBox">
            <SlowText message = "I've been mea-hee-ning to get to know you better! Put 'er there, ho! "/>
            <SlowText message = "(You shook hands with the demon... A piece of paper was left in your hand. It says, 'Sucker!') ", id= "heeho!", targetid = {dialogueFistbump[0]}/>
            <SlowText message = "Do you have a heart of stone or something? Who wouldn't wanna shake hands with me, ho!? Maybe this will get you to open up, ho.", id = "tags", targetid = {dialogueFistbump[1]}/>
        </div>
        <DialogueButton buttonTxt = 'Sure', id = {dialogueFistbump[0]}>
        </DialogueButton>
        <DialogueButton buttonTxt = 'Let&apos;s not.', id = {dialogueFistbump[1]}>
        </DialogueButton>

    </div>
</body>

<script>
function hideDialogue() {
    var options = document.querySelectorAll('.button');
    options.forEach(options => {
          options.style.display = 'none';
      });
    var text = document.getElementById('Undefined');
    text.remove();
    
}

let elements = document.querySelectorAll('.button');

elements.forEach((item) => {
    item.addEventListener('click', () => {
      hideDialogue();
      if (item == elements[0])
        setTimeout('location.assign("/blog/1")', 6000);
      if (item == elements[1])
      {
        var text = document.getElementById('fistbump');
        text.remove();
        setTimeout('location.assign("/jackfrost")', 6000);     
      }
        
    })
});
</script>

<style>
    body{
        background-image: url(../assets/backgrounds/jackfrostbackground.jpg);
        background-size: cover;
    }

    div.container {
    
	border-radius: 5px;
	border: solid;
	border-color: rgba(232, 42, 211, 0.54);
	border-width: 2px;
	margin:auto;
	padding: 1%;
	width: 50%;
        color:antiquewhite;
	justify-content: center;
	background-color:#28243d;
    }

    img{
        display: block;
        margin:auto;
    }
    .container{
        text-align: center;
    }
    .textBox{
        text-align: left;
        border: solid;
        border-color: white;
        width: 70%;
        height: 4em;
        margin: auto;
        margin-bottom: 1em;
    }

    @media only screen and (max-width: 1000px) {
    .textBox {
            width: 100%;
            height: 8em;
    }
    div.container{
        width: 85%;
    }
    }
        

</style>
</html>